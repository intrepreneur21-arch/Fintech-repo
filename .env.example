# ============================================================================
# AI Fintech Platform Builder - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MySQL/TiDB connection string
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://user:password@localhost:3306/fintech_db

# ============================================================================
# RAZORPAY PAYMENT INTEGRATION
# ============================================================================
# Get these from your Razorpay dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# ============================================================================
# MANUS OAUTH AUTHENTICATION
# ============================================================================
# Your Manus application ID (from Manus dashboard)
VITE_APP_ID=your_manus_app_id

# Manus OAuth server URL
OAUTH_SERVER_URL=https://api.manus.im

# Manus OAuth portal URL (for frontend redirects)
VITE_OAUTH_PORTAL_URL=https://portal.manus.im

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
# Secret key for signing JWT tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# ============================================================================
# MANUS BUILT-IN APIS (LLM, Storage, Notifications)
# ============================================================================
# Manus Forge API URL for server-side operations
BUILT_IN_FORGE_API_URL=https://api.manus.im/forge

# Manus Forge API key for server-side authentication
BUILT_IN_FORGE_API_KEY=your_forge_api_key

# Manus Forge API URL for frontend operations
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im/forge

# Manus Forge API key for frontend authentication
VITE_FRONTEND_FORGE_API_KEY=your_frontend_forge_key

# ============================================================================
# OWNER INFORMATION
# ============================================================================
# Your Manus OpenID (unique identifier)
OWNER_OPEN_ID=your_owner_open_id

# Your name or business name
OWNER_NAME=Your Business Name

# ============================================================================
# ANALYTICS (OPTIONAL)
# ============================================================================
# Analytics endpoint URL (optional)
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com

# Analytics website ID (optional)
VITE_ANALYTICS_WEBSITE_ID=your_website_id

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application title (displayed in UI)
VITE_APP_TITLE=Payment Builder AI

# Application logo URL
VITE_APP_LOGO=https://your-logo-url.png

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
# Set to 'development' for local development, 'production' for deployment
NODE_ENV=development

# ============================================================================
# INSTRUCTIONS FOR OBTAINING CREDENTIALS
# ============================================================================
#
# 1. RAZORPAY CREDENTIALS:
#    - Go to https://dashboard.razorpay.com/app/keys
#    - Copy your Test/Live Key ID and Key Secret
#    - Use Test keys for development, Live keys for production
#
# 2. MANUS CREDENTIALS:
#    - Sign up at https://manus.im
#    - Create a new application
#    - Get your App ID and OAuth credentials
#    - Generate API keys for Forge services
#
# 3. DATABASE:
#    - Set up MySQL 8.0+ or TiDB database
#    - Create a new database for this application
#    - Update DATABASE_URL with your credentials
#
# 4. JWT_SECRET:
#    - Generate a random 32+ character string
#    - Command: openssl rand -base64 32
#    - Or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ============================================================================
